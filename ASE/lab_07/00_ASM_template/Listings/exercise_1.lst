  137 00000000         ; Compute the number of cards that the player purchased 
                       at a lower price price than the current price and store 
                       it in register R11
  138 00000000        B 
                       count   RN               11          ;contatore che sodd
                                                            isfa la condizione
  139 00000000        2 
                       purchase_index
                               RN               2           ;indice purchase_pr
                                                            ice
  140 00000000        3 
                       current_index
                               RN               3           ;indice current_pri
                                                            ce 
  141 00000000        4 
                       carte_totali
                               RN               4           ;carte_totali
  142 00000000         
  143 00000000 F04F 0B00       MOV              count, #0   ;contatore che sodd
                                                            isfa la condizione
  144 00000004 F04F 0A00       MOV              R10, #0
  145 00000008 4C0C            LDR              carte_totali, =tot_cards ;indir
                                                            izzo tot_cards
  146 0000000A 6824            LDR              carte_totali, [carte_totali] ; 
                                                             7 = valore inizial
                                                            e delle carte total
                                                            i
  147 0000000C 4A0C            LDR              purchase_index, =purchase_price
  148 0000000E         
  149 0000000E         
  150 0000000E F852 5B04 
                       purchase_loop
                               LDR              R5, [purchase_index], #4 ;ID CA
                                                            RTE purchase_price
  151 00000012 F852 6B04       LDR              R6, [purchase_index], #4 ;Prezz
                                                            o carte purchase_pr
                                                            ice
  152 00000016 4B0B            LDR              current_index, =current_price ;
                                                             ricomincio a scorr
                                                            ere current_price
  153 00000018         
  154 00000018         ;ho acquistato la carta R5 al prezzo R6
  155 00000018         ;devo trovare indirizzo di R7 in current_price
  156 00000018         



